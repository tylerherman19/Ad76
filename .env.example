# Dane County election id for the August 11 2026 primary.
# This now defaults to 194 in config/default.json (the county's "2026 Partisan
# Primary"; the AD76 DEM race is number 0065). Leave unset to use that default.
# Unset/empty here does NOT blank the config value.
# To re-check, or to find a different election:
#   curl -s https://api.danecounty.gov/api/v1/elections/list | jq 'sort_by(.ElectionDate)|.[-3:]'
ELECTION_ID=

# api | html | auto  -- api is the election-night default (see README "Data sources")
SOURCE_MODE=api

# The county publishes "last updated" with no zone marker, in its own local
# time. Both source paths convert with this, so the displayed time does not
# depend on the server's TZ. Only change this if the county moves.
COUNTY_TIME_ZONE=America/Chicago

# Race discovery. The race number is found by matching this pattern against the
# county's race list, so RACE_NUMBER is only needed if that fails.
# RACE_NAME_PATTERN=DEM\s+Representative to the Assembly District\s+76\b
# RACE_NUMBER=

# Refresh cadence. Adjustable on the night without a code change.
IDLE_INTERVAL_MS=60000
ACTIVE_INTERVAL_MS=15000
REPORTING_THRESHOLD=1
FORCE_REFRESH_COOLDOWN_MS=12000
STALE_AFTER_MS=180000

PORT=8080
HOST=0.0.0.0
